# Copy to backend/.env (never commit .env).

# Platform key for the Claude API: https://platform.claude.com/settings/keys
# Every user's requests are billed to this key.
ANTHROPIC_API_KEY=

# Hard daily cap on real-model spend across all users, in USD. 0 = no cap.
SIFT_DAILY_BUDGET_USD=2

# Reply length: the default limit per reply, and the hard cap that /long can
# raise it to. Claude 5.5 models can write up to 128K tokens.
SIFT_DEFAULT_OUTPUT_TOKENS=8000
SIFT_MAX_OUTPUT_TOKENS=32000

# Keep the free mock models in the picker alongside real ones.
SIFT_ENABLE_MOCK_MODELS=true

# Where data lives: sqlite (backend/data/sift.db), memory, or dynamodb (not built yet).
SIFT_STORAGE=sqlite

# Plan a brand-new account starts on: free, plus, pro or team.
# Defaults: pro for the local dev user, free when SIFT_AUTH=cognito.
# SIFT_DEFAULT_PLAN=pro

# Sign-in. "local" = no sign-in (one dev user). "cognito" = real accounts;
# fill these from the SiftAuth stack outputs (see infra/README.md).
SIFT_AUTH=local
# SIFT_COGNITO_REGION=us-east-1
# SIFT_COGNITO_USER_POOL_ID=
# SIFT_COGNITO_CLIENT_ID=
# SIFT_COGNITO_DOMAIN=https://sift-<account>.auth.us-east-1.amazoncognito.com
# Extra sign-in buttons, once set up in Cognito:
# SIFT_COGNITO_PROVIDERS=Google

# Signs secure-folder unlock tokens. Optional locally (a random key is used,
# so unlocks end when the API restarts). In AWS, set it from Secrets Manager
# so every API container accepts the same tokens.
# SIFT_SECRET_KEY=
