# Copy to backend/.env (never commit .env).

# Platform key for the Claude API: https://platform.claude.com/settings/keys
# Every user's requests are billed to this key.
ANTHROPIC_API_KEY=

# Hard daily spending cap across all users, in USD. 0 = no cap.
SIFT_DAILY_BUDGET_USD=2

# Upper limit on reply length per request.
SIFT_MAX_OUTPUT_TOKENS=2048

# Keep the free mock models in the picker alongside real ones.
SIFT_ENABLE_MOCK_MODELS=true
